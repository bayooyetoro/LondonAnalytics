# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example          # always keep the example template
*.pem
*.key
*.p12
*.pfx
*.cert


# =============================================================================
# TERRAFORM
# =============================================================================
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
terraform/crash.log
terraform/plan.out


# =============================================================================
# RAW DATA — never commit source files
# =============================================================================
ingestion/**/raw/
ingestion/**/raw/**
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.delta
*.avro
*.orc
*.geojson
*.shp
*.dbf
*.prj
*.shx


# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
pytest.xml


# =============================================================================
# JUPYTER NOTEBOOKS
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
profile_default/
ipython_config.py


