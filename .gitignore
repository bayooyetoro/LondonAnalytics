ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# =============================================================================
# IDEs & EDITORS
# =============================================================================

# VS Code
.vscode/
!.vscode/extensions.json   # keep recommended extensions list
!.vscode/settings.json     # keep shared project settings

# JetBrains (PyCharm etc)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Emacs
*.swp
*.swo
\#*\#
.\#*


